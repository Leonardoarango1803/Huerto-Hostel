# Copia este archivo como .env y completa los valores reales
# NUNCA subas .env al repositorio

DATABASE_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_USERNAME=postgres.xxxxxxxxxxxxxxxxx
DATABASE_PASSWORD=

JWT_SECRET=genera-un-string-aleatorio-de-64-caracteres-minimo-aqui

# Sitios que pueden llamar a la API, separados por coma (en Render: la web publica y el portal administrativo)
FRONTEND_URL=http://localhost:5173

DECOLECTA_API_KEY=

# Google (ID de cliente OAuth, publico). Vacio = "Continuar con Google" apagado
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile (clave SECRETA del servidor). Vacio = captcha apagado
TURNSTILE_SECRET=

# Puerto local del backend (no cambiar en dev)
PORT=8091
